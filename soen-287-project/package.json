{
	"name": "soen-287-project",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"vite dev --config vite.client.config.js\" \"wrangler dev\"",
		"dev:cloudflare": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"sqlLocal": "npx wrangler d1 execute website-db --local --file=./schemas/schema.sql",
		"sqlRemote": "npx wrangler d1 execute website-db --remote --file=./schemas/schema.sql"
	},
	"dependencies": {
		"@types/express": "^4.17.25",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"express": "^4.22.1",
		"express-session": "^1.19.0",
		"passport": "^0.7.0",
		"passport-local": "^1.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-fontawesome": "^1.7.1",
		"react-router-dom": "^7.13.0",
		"recharts": "^3.7.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.23.1",
		"@eslint/js": "^9.33.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/passport": "^1.0.17",
		"@types/passport-local": "^1.0.38",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.0.0",
		"concurrently": "^9.2.1",
